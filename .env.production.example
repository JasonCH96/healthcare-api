# Runtime: /etc/citabox/api.env on the droplet. Do not commit actual values.
NODE_ENV=production
HOST=172.18.0.1
PORT=3001
DATABASE_URL=postgresql://citabox:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/citabox
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES
CORS_ORIGINS=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
ENABLE_SWAGGER=false
PUPPETEER_CACHE_DIR=/var/cache/citabox/puppeteer

# Optional: DigitalOcean Spaces / another private S3-compatible bucket
# AWS_REGION=nyc3
# AWS_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# AWS_S3_BUCKET=your-private-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional: team invitations via Resend
# RESEND_API_KEY=
# INVITE_FROM_EMAIL=soporte@your-domain.com

# Optional: WhatsApp webhook
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_WEBHOOK_AUTH_HEADER=Authorization
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_REQUEST_TIMEOUT_MS=10000

# One-time seed only. Use a separate root-readable file, not runtime variables.
# MOCK_USER_PASSWORD=
# MOCK_PATIENT_PASSWORD=
# SUPER_ADMIN_PASSWORD=
# DEMO_ADMIN_PASSWORD=
# DEMO_DOCTOR_PASSWORD=
# DEMO_STAFF_PASSWORD=
